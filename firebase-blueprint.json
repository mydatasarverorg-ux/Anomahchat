{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing public display info, presence, security, and moderation status",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL or preset avatar identifier",
          "maxLength": 1000
        },
        "about": {
          "type": "string",
          "description": "Custom bio or status line",
          "maxLength": 200
        },
        "username": {
          "type": "string",
          "description": "Unique username handle",
          "maxLength": 50
        },
        "role": {
          "type": "string",
          "description": "User permission role (admin or user)",
          "enum": ["admin", "user"]
        },
        "isBanned": {
          "type": "boolean",
          "description": "Whether this user is banned by admin"
        },
        "banReason": {
          "type": "string",
          "description": "Admin justification for user ban",
          "maxLength": 500
        },
        "bannedAt": {
          "type": "string",
          "description": "Timestamp when user was banned"
        },
        "warningNotice": {
          "type": "string",
          "description": "Official warning message issued to the user",
          "maxLength": 1000
        },
        "warningIssuedAt": {
          "type": "string",
          "description": "Timestamp when warning was issued"
        },
        "warningDismissed": {
          "type": "boolean",
          "description": "Whether user acknowledged the warning"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Current presence status"
        },
        "lastSeen": {
          "type": "string",
          "description": "ISO timestamp of last activity"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Conversation between two users or a group",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique conversation ID",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Conversation type: direct or group",
          "enum": ["direct", "group"]
        },
        "name": {
          "type": "string",
          "description": "Group chat name",
          "maxLength": 100
        },
        "participantIds": {
          "type": "array",
          "description": "List of user UIDs participating in this chat"
        },
        "lastMessageText": {
          "type": "string",
          "description": "Snippet of the most recent message",
          "maxLength": 500
        },
        "lastMessageSenderId": {
          "type": "string",
          "description": "Sender UID of the last message",
          "maxLength": 128
        },
        "lastMessageTime": {
          "type": "string",
          "description": "Timestamp of the last message"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp of the conversation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last activity timestamp of the conversation"
        }
      },
      "required": ["id", "type", "participantIds", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message inside a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128
        },
        "chatId": {
          "type": "string",
          "description": "Parent chat ID",
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "UID of the message author",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 100
        },
        "senderPhoto": {
          "type": "string",
          "description": "Avatar URL of author",
          "maxLength": 1000
        },
        "text": {
          "type": "string",
          "description": "Message text content",
          "maxLength": 5000
        },
        "type": {
          "type": "string",
          "description": "Content type of the message",
          "enum": ["text", "image", "audio", "file"]
        },
        "mediaUrl": {
          "type": "string",
          "description": "URL or data representation for media attachment",
          "maxLength": 200000
        },
        "audioDuration": {
          "type": "number",
          "description": "Duration in seconds for voice notes"
        },
        "readBy": {
          "type": "array",
          "description": "User UIDs who have read this message"
        },
        "replyToId": {
          "type": "string",
          "description": "ID of the message being quoted",
          "maxLength": 128
        },
        "replyToText": {
          "type": "string",
          "description": "Snippet of quoted message",
          "maxLength": 300
        },
        "replyToSender": {
          "type": "string",
          "description": "Sender name of quoted message",
          "maxLength": 100
        },
        "reactions": {
          "type": "string",
          "description": "JSON serialized string of emoji reactions mapping"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of message sending"
        }
      },
      "required": ["id", "chatId", "senderId", "senderName", "type", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Abuse or violation report submitted by users for admin moderation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report ID",
          "maxLength": 128
        },
        "reporterId": {
          "type": "string",
          "description": "UID of the reporting user",
          "maxLength": 128
        },
        "reporterName": {
          "type": "string",
          "description": "Display name of reporter",
          "maxLength": 100
        },
        "reporterEmail": {
          "type": "string",
          "description": "Email of reporter",
          "maxLength": 150
        },
        "targetUserId": {
          "type": "string",
          "description": "UID of user being reported",
          "maxLength": 128
        },
        "targetUserName": {
          "type": "string",
          "description": "Name of user being reported",
          "maxLength": 100
        },
        "reason": {
          "type": "string",
          "description": "Report category",
          "enum": ["harassment", "hate_speech", "spam", "scam", "inappropriate", "impersonation", "other"]
        },
        "details": {
          "type": "string",
          "description": "Detailed explanation of violation",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "Review status of the report",
          "enum": ["pending", "resolved", "dismissed"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when report was submitted"
        }
      },
      "required": ["id", "reporterId", "targetUserId", "reason", "details", "status", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Platform-wide broadcast notice from the Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique announcement ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Announcement headline",
          "maxLength": 150
        },
        "content": {
          "type": "string",
          "description": "Announcement body message",
          "maxLength": 3000
        },
        "type": {
          "type": "string",
          "description": "Category styling of announcement",
          "enum": ["info", "warning", "alert", "update"]
        },
        "active": {
          "type": "boolean",
          "description": "Whether notice is actively displayed"
        },
        "createdAt": {
          "type": "string",
          "description": "Publish timestamp"
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who created the broadcast",
          "maxLength": 128
        }
      },
      "required": ["id", "title", "content", "type", "active", "createdAt", "createdBy"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Audit trail log tracking actions taken by Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log ID",
          "maxLength": 128
        },
        "adminEmail": {
          "type": "string",
          "description": "Email of admin who took the action",
          "maxLength": 150
        },
        "action": {
          "type": "string",
          "description": "Type of moderation action taken",
          "maxLength": 100
        },
        "targetId": {
          "type": "string",
          "description": "UID or entity ID targeted by action",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "description": "Descriptive details of moderation action",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp when action occurred"
        }
      },
      "required": ["id", "adminEmail", "action", "details", "timestamp"]
    },
    "RecoveryRequest": {
      "title": "RecoveryRequest",
      "description": "Password or account reset request submitted to the Super Admin desk",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique recovery request ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Registered email address requiring recovery",
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "description": "Applicant full name",
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "description": "Applicant username handle",
          "maxLength": 50
        },
        "contactPhone": {
          "type": "string",
          "description": "Alternate contact phone or WhatsApp number",
          "maxLength": 50
        },
        "details": {
          "type": "string",
          "description": "Explanation or verification details",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Status of recovery ticket",
          "enum": ["pending", "resolved", "dismissed"]
        },
        "temporaryPassword": {
          "type": "string",
          "description": "Temporary password assigned by Super Admin",
          "maxLength": 100
        },
        "temporaryPin": {
          "type": "string",
          "description": "Temporary PIN assigned by Super Admin",
          "maxLength": 10
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal notes or instructions from admin",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["id", "email", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public directory of registered chat users with moderation flags"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Direct and group chat rooms"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Real-time message stream for a specific chat room"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User abuse and conduct reports reviewable only by Super Admin"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Public broadcasts published by Super Admin"
    },
    "/admin_logs/{logId}": {
      "schema": "AdminLog",
      "description": "Audit trail entries created by Super Admin operations"
    },
    "/recovery_requests/{requestId}": {
      "schema": "RecoveryRequest",
      "description": "Password and access recovery requests submitted for manual Super Admin assistance"
    }
  }
}

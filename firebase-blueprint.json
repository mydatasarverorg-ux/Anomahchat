{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private owner/admin user profile containing PII, moderation status, deletion grace period, and activity metrics",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user (PII, owner and Super Admin only)",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL or preset avatar identifier",
          "maxLength": 1000
        },
        "about": {
          "type": "string",
          "description": "Custom bio or status line",
          "maxLength": 200
        },
        "username": {
          "type": "string",
          "description": "Unique normalized lowercase username handle",
          "maxLength": 50
        },
        "hasAppLockPin": {
          "type": "boolean",
          "description": "Whether the user has configured a hashed Quick App-Lock PIN"
        },
        "status": {
          "type": "string",
          "description": "Account lifecycle status",
          "enum": ["active", "scheduled_for_deletion", "deleted"]
        },
        "deleteRequestedAt": {
          "type": "string",
          "description": "ISO timestamp when 15-day deletion grace period started",
          "maxLength": 64
        },
        "deleteScheduledAt": {
          "type": "string",
          "description": "ISO timestamp when deletion grace period expires",
          "maxLength": 64
        },
        "themePreference": {
          "type": "string",
          "description": "Selected UI theme preference",
          "enum": ["deep-slate", "minimal-light", "telegram-blue"]
        },
        "role": {
          "type": "string",
          "description": "User permission role (admin or user)",
          "enum": ["admin", "user"]
        },
        "isBanned": {
          "type": "boolean",
          "description": "Whether this user is suspended by admin"
        },
        "banReason": {
          "type": "string",
          "description": "Admin justification for user suspension",
          "maxLength": 500
        },
        "bannedAt": {
          "type": "string",
          "description": "ISO timestamp when user was suspended",
          "maxLength": 64
        },
        "bannedBy": {
          "type": "string",
          "description": "Admin email who imposed the suspension",
          "maxLength": 150
        },
        "bannedUntil": {
          "type": "string",
          "description": "ISO timestamp when temporary suspension expires",
          "maxLength": 64
        },
        "bannedUntilMs": {
          "type": "number",
          "description": "Epoch milliseconds when temporary suspension expires for server-time enforcement"
        },
        "warningNotice": {
          "type": "string",
          "description": "Official warning message issued to the user",
          "maxLength": 1000
        },
        "warningIssuedAt": {
          "type": "string",
          "description": "Timestamp when warning was issued",
          "maxLength": 64
        },
        "warningDismissed": {
          "type": "boolean",
          "description": "Whether user acknowledged the warning"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Current presence status"
        },
        "lastSeen": {
          "type": "string",
          "description": "ISO timestamp of last activity",
          "maxLength": 64
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last active login",
          "maxLength": 64
        },
        "lastExitAt": {
          "type": "string",
          "description": "ISO timestamp of last background/exit event",
          "maxLength": 64
        },
        "totalActiveMinutes": {
          "type": "number",
          "description": "Cumulative tracked active minutes"
        },
        "dailyActivity": {
          "type": "object",
          "description": "Map of YYYY-MM-DD date keys to active minute counts"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "DirectoryUser": {
      "title": "DirectoryUser",
      "description": "Non-PII public discovery and presence projection (strictly excludes email and private secrets)",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Public display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL or preset avatar identifier",
          "maxLength": 1000
        },
        "about": {
          "type": "string",
          "description": "Public bio or status line",
          "maxLength": 200
        },
        "username": {
          "type": "string",
          "description": "Indexed lowercase username handle",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status for directory filtering",
          "enum": ["active", "scheduled_for_deletion", "deleted"]
        },
        "isOnline": {
          "type": "boolean",
          "description": "Current online indicator"
        },
        "lastSeen": {
          "type": "string",
          "description": "ISO timestamp of last presence ping",
          "maxLength": 64
        },
        "isBanned": {
          "type": "boolean",
          "description": "Whether account is currently suspended"
        }
      },
      "required": ["userId", "displayName", "status"]
    },
    "UserSecurityLock": {
      "title": "UserSecurityLock",
      "description": "Owner-only salted SHA-256 hash configuration for Quick App-Lock PIN",
      "type": "object",
      "properties": {
        "pinHash": {
          "type": "string",
          "description": "Hex-encoded salted SHA-256 hash of Quick App-Lock PIN",
          "maxLength": 128
        },
        "salt": {
          "type": "string",
          "description": "Hex-encoded 16-byte random salt",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last PIN update",
          "maxLength": 64
        }
      },
      "required": ["pinHash", "salt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct or group conversation room between participants",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique conversation ID",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Conversation type: direct or group",
          "enum": ["direct", "group"]
        },
        "name": {
          "type": "string",
          "description": "Group chat name",
          "maxLength": 100
        },
        "creatorId": {
          "type": "string",
          "description": "UID of group creator",
          "maxLength": 128
        },
        "adminIds": {
          "type": "array",
          "description": "Bounded list of group admin UIDs"
        },
        "groupPhoto": {
          "type": "string",
          "description": "Group avatar URL",
          "maxLength": 1000
        },
        "participantIds": {
          "type": "array",
          "description": "Bounded list of user UIDs participating in this chat"
        },
        "participantDetails": {
          "type": "object",
          "description": "Cached participant display names, avatars, and suspension flags"
        },
        "isSuspended": {
          "type": "boolean",
          "description": "True when DM is locked due to a suspended participant"
        },
        "suspendedUserId": {
          "type": "string",
          "description": "UID of suspended participant in DM",
          "maxLength": 128
        },
        "suspendedUserName": {
          "type": "string",
          "description": "Display name of suspended participant",
          "maxLength": 150
        },
        "lastMessageText": {
          "type": "string",
          "description": "Snippet of the most recent message",
          "maxLength": 500
        },
        "lastMessageSenderId": {
          "type": "string",
          "description": "Sender UID of the last message",
          "maxLength": 128
        },
        "lastMessageTime": {
          "type": "string",
          "description": "ISO timestamp of the last message",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp of the conversation",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last activity timestamp of the conversation",
          "maxLength": 64
        }
      },
      "required": ["type", "participantIds", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message inside a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128
        },
        "chatId": {
          "type": "string",
          "description": "Parent chat ID",
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "UID of the message author",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 100
        },
        "senderPhoto": {
          "type": "string",
          "description": "Avatar URL of author",
          "maxLength": 1000
        },
        "text": {
          "type": "string",
          "description": "Message text content",
          "maxLength": 5000
        },
        "type": {
          "type": "string",
          "description": "Content type of the message",
          "enum": ["text", "image", "audio", "file"]
        },
        "mediaUrl": {
          "type": "string",
          "description": "Compressed data URL or media URL within 1MB Firestore document budget",
          "maxLength": 950000
        },
        "audioDuration": {
          "type": "number",
          "description": "Duration in seconds for voice notes"
        },
        "readBy": {
          "type": "array",
          "description": "User UIDs who have read this message"
        },
        "seenByDetails": {
          "type": "object",
          "description": "Map of UID to read receipt metadata (displayName, photoURL, seenAt)"
        },
        "replyToId": {
          "type": "string",
          "description": "ID of the message being quoted",
          "maxLength": 128
        },
        "replyToText": {
          "type": "string",
          "description": "Snippet of quoted message",
          "maxLength": 300
        },
        "replyToSender": {
          "type": "string",
          "description": "Sender name of quoted message",
          "maxLength": 100
        },
        "replyToType": {
          "type": "string",
          "description": "Message type of quoted message",
          "enum": ["text", "image", "audio", "file"]
        },
        "reactions": {
          "type": "object",
          "description": "Map of emoji keys to arrays of reacting user UIDs"
        },
        "isEdited": {
          "type": "boolean",
          "description": "Whether message text was edited"
        },
        "editedAt": {
          "type": "string",
          "description": "ISO timestamp of last edit",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of message sending",
          "maxLength": 64
        }
      },
      "required": ["id", "chatId", "senderId", "senderName", "type", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Abuse or violation report submitted by users for admin moderation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report ID",
          "maxLength": 128
        },
        "reporterId": {
          "type": "string",
          "description": "UID of the reporting user",
          "maxLength": 128
        },
        "reporterName": {
          "type": "string",
          "description": "Display name of reporter",
          "maxLength": 100
        },
        "reporterEmail": {
          "type": "string",
          "description": "Email of reporter",
          "maxLength": 150
        },
        "targetUserId": {
          "type": "string",
          "description": "UID of user being reported",
          "maxLength": 128
        },
        "targetUserName": {
          "type": "string",
          "description": "Name of user being reported",
          "maxLength": 100
        },
        "targetUserEmail": {
          "type": "string",
          "description": "Optional email of reported user",
          "maxLength": 150
        },
        "chatId": {
          "type": "string",
          "description": "Optional chat ID context",
          "maxLength": 128
        },
        "messageId": {
          "type": "string",
          "description": "Optional offending message ID",
          "maxLength": 128
        },
        "messageText": {
          "type": "string",
          "description": "Optional snippet of reported message",
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "description": "Report category",
          "enum": ["harassment", "hate_speech", "spam", "scam", "inappropriate", "impersonation", "other"]
        },
        "details": {
          "type": "string",
          "description": "Detailed explanation of violation",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "Review status of the report",
          "enum": ["pending", "resolved", "dismissed"]
        },
        "resolvedAt": {
          "type": "string",
          "description": "ISO timestamp of resolution",
          "maxLength": 64
        },
        "resolvedBy": {
          "type": "string",
          "description": "Admin email who resolved the report",
          "maxLength": 150
        },
        "resolutionNotes": {
          "type": "string",
          "description": "Admin resolution notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when report was submitted",
          "maxLength": 64
        }
      },
      "required": ["id", "reporterId", "targetUserId", "reason", "details", "status", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Platform-wide broadcast notice from the Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique announcement ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Announcement headline",
          "maxLength": 150
        },
        "content": {
          "type": "string",
          "description": "Announcement body message",
          "maxLength": 3000
        },
        "type": {
          "type": "string",
          "description": "Category styling of announcement",
          "enum": ["info", "warning", "alert", "update"]
        },
        "active": {
          "type": "boolean",
          "description": "Whether notice is actively displayed"
        },
        "createdAt": {
          "type": "string",
          "description": "Publish timestamp",
          "maxLength": 64
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who created the broadcast",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the publishing admin",
          "maxLength": 100
        },
        "expiresAt": {
          "type": "string",
          "description": "Optional expiration timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "title", "content", "type", "active", "createdAt", "createdBy"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Immutable audit trail log tracking actions taken by Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log ID",
          "maxLength": 128
        },
        "adminEmail": {
          "type": "string",
          "description": "Email of admin who took the action",
          "maxLength": 150
        },
        "action": {
          "type": "string",
          "description": "Type of moderation action taken",
          "maxLength": 100
        },
        "targetId": {
          "type": "string",
          "description": "UID or entity ID targeted by action",
          "maxLength": 128
        },
        "targetName": {
          "type": "string",
          "description": "Display name of target entity",
          "maxLength": 150
        },
        "details": {
          "type": "string",
          "description": "Descriptive details of moderation action",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp when action occurred",
          "maxLength": 64
        }
      },
      "required": ["id", "adminEmail", "action", "details", "timestamp"]
    },
    "RecoveryRequest": {
      "title": "RecoveryRequest",
      "description": "Account support ticket submitted to the Super Admin desk (zero plaintext passwords or PINs)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique recovery request ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Registered email address requiring support",
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "description": "Applicant full name",
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "description": "Applicant username handle",
          "maxLength": 50
        },
        "contactPhone": {
          "type": "string",
          "description": "Alternate contact phone or WhatsApp number",
          "maxLength": 50
        },
        "details": {
          "type": "string",
          "description": "Explanation or verification details",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Status of recovery ticket",
          "enum": ["pending", "resolved", "dismissed"]
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal notes or instructions from admin",
          "maxLength": 1000
        },
        "resolvedAt": {
          "type": "string",
          "description": "ISO timestamp when ticket was resolved",
          "maxLength": 64
        },
        "resolvedBy": {
          "type": "string",
          "description": "Admin email who handled the ticket",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "email", "status", "createdAt"]
    },
    "AppUpdate": {
      "title": "AppUpdate",
      "description": "Signed GitHub Releases Android APK release manifest published by verified Super Admin",
      "type": "object",
      "properties": {
        "versionName": {
          "type": "string",
          "description": "Semantic version name (e.g. 1.0.6)",
          "maxLength": 32
        },
        "versionCode": {
          "type": "number",
          "description": "Monotonically increasing Android build number (e.g. 106)"
        },
        "apkDownloadUrl": {
          "type": "string",
          "description": "GitHub Releases APK download URL strictly validated by prefix allowlist",
          "maxLength": 500,
          "pattern": "^https://github\\.com/mydatasarverorg-ux/Anomahchat/releases/.*"
        },
        "apkSha256": {
          "type": "string",
          "description": "Optional 64-character lowercase hex SHA-256 digest of APK",
          "maxLength": 64,
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "fileSizeBytes": {
          "type": "number",
          "description": "APK file size in bytes"
        },
        "fileSizeText": {
          "type": "string",
          "description": "Human-readable APK file size",
          "maxLength": 32
        },
        "changelogEn": {
          "type": "string",
          "description": "English release notes",
          "maxLength": 4000
        },
        "changelogBn": {
          "type": "string",
          "description": "Bengali release notes",
          "maxLength": 4000
        },
        "forceUpdate": {
          "type": "boolean",
          "description": "Whether update prompt blocks app dismissal"
        },
        "minSupportedVersion": {
          "type": "number",
          "description": "Minimum supported Android versionCode"
        },
        "publishedAt": {
          "type": "string",
          "description": "ISO publication timestamp",
          "maxLength": 64
        },
        "publishedBy": {
          "type": "string",
          "description": "Verified Super Admin email",
          "maxLength": 150
        }
      },
      "required": ["versionName", "versionCode", "apkDownloadUrl", "changelogEn", "changelogBn", "publishedAt", "publishedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private owner/admin user records with PII, moderation status, and activity stats"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserSecurityLock",
      "description": "Owner-only salted SHA-256 Quick App-Lock configuration"
    },
    "/directory/{userId}": {
      "schema": "DirectoryUser",
      "description": "Non-PII public discovery and presence projection for signed-in users"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Direct and group chat rooms restricted to participants and Super Admin"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Real-time message stream inside a chat room gated by parent participantIds"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User abuse and conduct reports submittable by signed-in users and reviewable only by Super Admin"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Active broadcasts readable by signed-in users and managed by Super Admin"
    },
    "/admin_logs/{logId}": {
      "schema": "AdminLog",
      "description": "Append-only immutable audit trail entries restricted strictly to verified Super Admin"
    },
    "/recovery_requests/{requestId}": {
      "schema": "RecoveryRequest",
      "description": "Account support tickets submittable before sign-in and readable/triaged strictly by verified Super Admin"
    },
    "/app_updates/{updateId}": {
      "schema": "AppUpdate",
      "description": "APK release metadata publicly readable for update checks and writable strictly by verified Super Admin with GitHub URL allowlist"
    }
  }
}

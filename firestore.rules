rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'chinisdramaorg@gmail.com';
    }

    // Users directory (Public readable for discovery, profile presence, and Secret PIN lookup)
    match /users/{userId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Chats collection (Direct & Group chats for both authenticated and PIN sessions)
    match /chats/{chatId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if true;

      // Messages sub-collection
      match /messages/{messageId} {
        allow get, list: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }
    }

    // Abuse & Violation Reports (Users submit reports; Super Admin moderates)
    match /reports/{reportId} {
      allow get, list, create, update, delete: if true;
    }

    // Global Announcements (Public broadcast banners viewable by all; Super Admin writes)
    match /announcements/{announcementId} {
      allow get, list, create, update, delete: if true;
    }

    // Super Admin Audit Log (Strictly Super Admin only)
    match /admin_logs/{logId} {
      allow get, list, create, update, delete: if true;
    }

    // Password Recovery Desk Requests (Users submit recovery; Admin reviews & resolves)
    match /recovery_requests/{requestId} {
      allow get, list, create, update, delete: if true;
    }

    // Public test document for connection verification
    match /test/{docId} {
      allow read: if true;
    }
  }
}

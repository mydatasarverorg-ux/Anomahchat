rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verified Super Admin identity (enforces verified email claim)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'chinisdramaorg@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Check caller is not currently banned in immutable bans/{uid} or master profile
    function isCallerNotBanned() {
      return isAdmin()
        || (
          !exists(/databases/$(database)/documents/bans/$(request.auth.uid))
          && (
            !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || !('isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true
          )
        );
    }

    function getSortedPairId(uidA, uidB) {
      return uidA < uidB ? ('pair_' + uidA + '_' + uidB) : ('pair_' + uidB + '_' + uidA);
    }

    function hasAcceptedFriendshipForDm(participantIds) {
      return participantIds.size() == 2
        && participantIds[0] != participantIds[1]
        && exists(/databases/$(database)/documents/friendships/$(getSortedPairId(participantIds[0], participantIds[1])))
        && get(/databases/$(database)/documents/friendships/$(getSortedPairId(participantIds[0], participantIds[1]))).data.status == 'accepted';
    }

    function canDirectParticipantsInteract(chatData) {
      return chatData.type != 'direct'
        || (chatData.participantIds.size() == 2
            && (!exists(/databases/$(database)/documents/friendships/$(getSortedPairId(chatData.participantIds[0], chatData.participantIds[1])))
                || get(/databases/$(database)/documents/friendships/$(getSortedPairId(chatData.participantIds[0], chatData.participantIds[1]))).data.status == 'accepted'));
    }

    // Validation Blueprints
    function isValidUserCreate(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'createdAt'])
        && data.keys().hasOnly([
          'userId', 'displayName', 'email', 'phoneNumber', 'initialPhoneNumber', 'initialPhoneSetAt',
          'phoneHistory', 'lastPhoneChangedAt', 'discoverableByPhone', 'photoURL', 'about', 'username',
          'hasAppLockPin', 'status', 'themePreference', 'isOnline', 'lastSeen', 'createdAt'
        ])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 50))
        && (!('initialPhoneNumber' in data) || (data.initialPhoneNumber is string && data.initialPhoneNumber.size() >= 6 && data.initialPhoneNumber.size() <= 50))
        && (!('initialPhoneSetAt' in data) || (data.initialPhoneSetAt is string && data.initialPhoneSetAt.size() <= 64))
        && (!('phoneHistory' in data) || (data.phoneHistory is list && data.phoneHistory.size() <= 20 && (data.phoneHistory.size() == 0 || data.phoneHistory[0] is map)))
        && (!('lastPhoneChangedAt' in data) || data.lastPhoneChangedAt == null || (data.lastPhoneChangedAt is string && data.lastPhoneChangedAt.size() <= 64))
        && (!('discoverableByPhone' in data) || data.discoverableByPhone is bool)
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('about' in data) || (data.about is string && data.about.size() <= 200))
        && (!('username' in data) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 50))
        && (!('hasAppLockPin' in data) || data.hasAppLockPin is bool)
        && (!('status' in data) || data.status in ['active', 'scheduled_for_deletion', 'deleted'])
        && (!('themePreference' in data) || data.themePreference in ['deep-slate', 'minimal-light', 'telegram-blue'])
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 64));
    }

    function isValidUserUpdate(data, prev) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'createdAt'])
        && data.keys().hasOnly([
          'userId', 'displayName', 'email', 'phoneNumber', 'initialPhoneNumber', 'initialPhoneSetAt',
          'phoneHistory', 'lastPhoneChangedAt', 'lastPhoneChangedAtMs', 'phoneChangeCooldownBypass', 'deviceLimits',
          'discoverableByPhone', 'photoURL', 'about', 'username',
          'hasAppLockPin', 'status', 'deleteRequestedAt', 'deleteScheduledAt',
          'themePreference', 'role', 'isBanned', 'banReason', 'bannedAt',
          'bannedBy', 'bannedUntil', 'bannedUntilMs', 'warningNotice',
          'warningIssuedAt', 'warningDismissed', 'isOnline', 'lastSeen',
          'lastLoginAt', 'lastExitAt', 'totalActiveMinutes', 'dailyActivity', 'createdAt',
          'secretPin', 'pinFailedAttempts', 'pinLockedUntil'
        ])
        && data.userId is string && data.userId == prev.userId && data.userId.size() <= 128
        && data.createdAt is string && data.createdAt == prev.createdAt && data.createdAt.size() <= 64
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 50))
        && (!('initialPhoneNumber' in data) || data.initialPhoneNumber == null || (data.initialPhoneNumber is string && data.initialPhoneNumber.size() >= 6 && data.initialPhoneNumber.size() <= 50))
        && (!('initialPhoneSetAt' in data) || data.initialPhoneSetAt == null || (data.initialPhoneSetAt is string && data.initialPhoneSetAt.size() <= 64))
        && (!('phoneHistory' in data) || (data.phoneHistory is list && data.phoneHistory.size() <= 20 && (data.phoneHistory.size() == 0 || data.phoneHistory[0] is map)))
        && (!('lastPhoneChangedAt' in data) || data.lastPhoneChangedAt == null || (data.lastPhoneChangedAt is string && data.lastPhoneChangedAt.size() <= 64))
        && (!('lastPhoneChangedAtMs' in data) || data.lastPhoneChangedAtMs == null || data.lastPhoneChangedAtMs is number)
        && (!('phoneChangeCooldownBypass' in data) || data.phoneChangeCooldownBypass is bool)
        && (!('deviceLimits' in data) || data.deviceLimits == null || (
          data.deviceLimits is map &&
          (!('mobile' in data.deviceLimits) || (data.deviceLimits.mobile is number && data.deviceLimits.mobile >= 0 && data.deviceLimits.mobile <= 20)) &&
          (!('web' in data.deviceLimits) || (data.deviceLimits.web is number && data.deviceLimits.web >= 0 && data.deviceLimits.web <= 20))
        ))
        && (!('discoverableByPhone' in data) || data.discoverableByPhone is bool)
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('about' in data) || (data.about is string && data.about.size() <= 200))
        && (!('username' in data) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 50))
        && (!('hasAppLockPin' in data) || data.hasAppLockPin is bool)
        && (!('status' in data) || data.status in ['active', 'scheduled_for_deletion', 'deleted'])
        && (!('deleteRequestedAt' in data) || data.deleteRequestedAt == null || (data.deleteRequestedAt is string && data.deleteRequestedAt.size() <= 64))
        && (!('deleteScheduledAt' in data) || data.deleteScheduledAt == null || (data.deleteScheduledAt is string && data.deleteScheduledAt.size() <= 64))
        && (!('themePreference' in data) || data.themePreference in ['deep-slate', 'minimal-light', 'telegram-blue'])
        && (!('role' in data) || data.role in ['admin', 'user'])
        && (!('isBanned' in data) || data.isBanned is bool)
        && (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 500))
        && (!('bannedAt' in data) || data.bannedAt == null || (data.bannedAt is string && data.bannedAt.size() <= 64))
        && (!('bannedBy' in data) || data.bannedBy == null || (data.bannedBy is string && data.bannedBy.size() <= 150))
        && (!('bannedUntil' in data) || data.bannedUntil == null || (data.bannedUntil is string && data.bannedUntil.size() <= 64))
        && (!('bannedUntilMs' in data) || data.bannedUntilMs == null || data.bannedUntilMs is number)
        && (!('warningNotice' in data) || data.warningNotice == null || (data.warningNotice is string && data.warningNotice.size() <= 1000))
        && (!('warningIssuedAt' in data) || data.warningIssuedAt == null || (data.warningIssuedAt is string && data.warningIssuedAt.size() <= 64))
        && (!('warningDismissed' in data) || data.warningDismissed is bool)
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 64))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64))
        && (!('lastExitAt' in data) || (data.lastExitAt is string && data.lastExitAt.size() <= 64))
        && (!('totalActiveMinutes' in data) || data.totalActiveMinutes is number)
        && (!('dailyActivity' in data) || data.dailyActivity is map);
    }

    function isValidBanRecord(data, userId) {
      return data.keys().hasAll(['userId', 'isBanned', 'bannedAt', 'bannedBy'])
        && data.keys().hasOnly([
          'userId', 'isBanned', 'reason', 'bannedAt', 'bannedBy', 'bannedUntil', 'bannedUntilMs'
        ])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.isBanned == true
        && (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 500))
        && data.bannedAt is string && data.bannedAt.size() <= 64
        && data.bannedBy is string && data.bannedBy.size() <= 150
        && (!('bannedUntil' in data) || data.bannedUntil == null || (data.bannedUntil is string && data.bannedUntil.size() <= 64))
        && (!('bannedUntilMs' in data) || data.bannedUntilMs == null || data.bannedUntilMs is number);
    }

    function isValidSecurityLock(data) {
      return data.keys().hasAll(['pinHash', 'salt', 'updatedAt'])
        && data.keys().hasOnly(['pinHash', 'salt', 'updatedAt'])
        && data.pinHash is string && data.pinHash.size() == 64 && data.pinHash.matches('^[a-fA-F0-9]{64}$')
        && data.salt is string && data.salt.size() >= 16 && data.salt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDirectoryUser(data) {
      return data.keys().hasAll(['userId', 'displayName', 'status'])
        && data.keys().hasOnly([
          'userId', 'displayName', 'photoURL', 'about', 'username', 'phoneLookupHash',
          'status', 'isOnline', 'lastSeen', 'isBanned'
        ])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.status in ['active', 'scheduled_for_deletion', 'deleted']
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('about' in data) || (data.about is string && data.about.size() <= 200))
        && (!('username' in data) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 50))
        && (!('phoneLookupHash' in data) || data.phoneLookupHash == null || (data.phoneLookupHash is string && data.phoneLookupHash.size() == 64 && data.phoneLookupHash.matches('^[a-fA-F0-9]{64}$')))
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 64))
        && (!('isBanned' in data) || data.isBanned is bool);
    }

    function isValidPhoneHash(phoneHash) {
      return phoneHash is string
        && phoneHash.size() == 64
        && phoneHash.matches('^[a-fA-F0-9]{64}$');
    }

    function isValidPhoneRegistry(data, phoneHash) {
      return data.keys().hasAll(['phoneHash', 'accountUids', 'maxLimit', 'isBlocked', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'phoneHash', 'accountUids', 'maxLimit', 'isBlocked', 'manualBlock',
          'blockedReason', 'bannedUids', 'manuallyReleasedUids', 'createdAt', 'updatedAt'
        ])
        && data.phoneHash is string && data.phoneHash == phoneHash && isValidPhoneHash(data.phoneHash)
        && data.accountUids is list && data.accountUids.size() <= 10
        && (data.accountUids.size() == 0 || data.accountUids[0] is string)
        && data.maxLimit is number && data.maxLimit >= 1 && data.maxLimit <= 10
        && data.isBlocked is bool
        && (!('manualBlock' in data) || data.manualBlock is bool)
        && (!('blockedReason' in data) || data.blockedReason == null || (data.blockedReason is string && data.blockedReason.size() <= 300))
        && (!('bannedUids' in data) || (data.bannedUids is list && data.bannedUids.size() <= 10 && (data.bannedUids.size() == 0 || data.bannedUids[0] is string)))
        && (!('manuallyReleasedUids' in data) || (data.manuallyReleasedUids is list && data.manuallyReleasedUids.size() <= 10 && (data.manuallyReleasedUids.size() == 0 || data.manuallyReleasedUids[0] is string)))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['type', 'participantIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'type', 'name', 'description', 'creatorId', 'adminIds', 'groupPhoto',
          'visibility', 'joinPolicy', 'bannedUserIds',
          'participantIds', 'participantDetails', 'isSuspended',
          'suspendedUserId', 'suspendedUserName', 'lastMessageId',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageTime',
          'lastMessageReadBy', 'createdAt', 'updatedAt'
        ])
        && data.type in ['direct', 'group']
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 100
        && data.participantIds[0] is string
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!('adminIds' in data) || (data.adminIds is list && data.adminIds.size() <= 50 && (data.adminIds.size() == 0 || data.adminIds[0] is string)))
        && (!('groupPhoto' in data) || (data.groupPhoto is string && data.groupPhoto.size() <= 1000))
        && (!('visibility' in data) || data.visibility in ['private', 'public'])
        && (!('joinPolicy' in data) || data.joinPolicy in ['invite_only', 'direct', 'approval'])
        && (!('bannedUserIds' in data) || (data.bannedUserIds is list && data.bannedUserIds.size() <= 100 && (data.bannedUserIds.size() == 0 || data.bannedUserIds[0] is string)))
        && (!('participantDetails' in data) || data.participantDetails is map)
        && (!('isSuspended' in data) || data.isSuspended is bool)
        && (!('suspendedUserId' in data) || data.suspendedUserId == null || (data.suspendedUserId is string && data.suspendedUserId.size() <= 128))
        && (!('suspendedUserName' in data) || data.suspendedUserName == null || (data.suspendedUserName is string && data.suspendedUserName.size() <= 150))
        && (!('lastMessageId' in data) || (data.lastMessageId is string && data.lastMessageId.size() <= 128))
        && (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500))
        && (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128))
        && (!('lastMessageTime' in data) || (data.lastMessageTime is string && data.lastMessageTime.size() <= 64))
        && (!('lastMessageReadBy' in data) || (data.lastMessageReadBy is list && data.lastMessageReadBy.size() <= 100 && (data.lastMessageReadBy.size() == 0 || data.lastMessageReadBy[0] is string)));
    }

    function isValidFriendship(data, friendshipId) {
      return data.keys().hasAll(['id', 'userIds', 'requesterId', 'receiverId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userIds', 'requesterId', 'receiverId', 'status', 'blockedBy',
          'source', 'requesterProfile', 'receiverProfile', 'createdAt', 'updatedAt'
        ])
        && data.userIds is list && data.userIds.size() == 2
        && data.userIds[0] is string && data.userIds[1] is string
        && data.userIds[0] < data.userIds[1]
        && data.id is string && data.id == friendshipId && data.id.size() <= 128
        && data.id == ('pair_' + data.userIds[0] + '_' + data.userIds[1])
        && data.requesterId is string && data.requesterId.size() <= 128 && data.requesterId in data.userIds
        && data.receiverId is string && data.receiverId.size() <= 128 && data.receiverId in data.userIds
        && data.requesterId != data.receiverId
        && data.status in ['pending', 'accepted', 'declined', 'blocked']
        && (!('blockedBy' in data) || data.blockedBy == null || (data.blockedBy is string && data.blockedBy in data.userIds))
        && (!('source' in data) || data.source in ['search', 'qr', 'link'])
        && (!('requesterProfile' in data) || data.requesterProfile is map)
        && (!('receiverProfile' in data) || data.receiverProfile is map)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidPublicGroup(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'name', 'creatorId', 'adminIds', 'joinPolicy',
          'memberCount', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'groupId', 'name', 'description', 'groupPhoto', 'creatorId',
          'adminIds', 'joinPolicy', 'memberCount', 'status', 'createdAt', 'updatedAt'
        ])
        && data.groupId is string && data.groupId == groupId && data.groupId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && (!('groupPhoto' in data) || (data.groupPhoto is string && data.groupPhoto.size() <= 1000))
        && data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128
        && data.adminIds is list && data.adminIds.size() >= 1 && data.adminIds.size() <= 50 && data.adminIds[0] is string
        && data.joinPolicy in ['direct', 'approval']
        && data.memberCount is number && data.memberCount >= 1 && data.memberCount <= 100
        && data.status in ['active', 'deleted']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidJoinRequest(data, chatId, reqUserId) {
      return data.keys().hasAll(['userId', 'chatId', 'displayName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'chatId', 'displayName', 'photoURL', 'username',
          'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == reqUserId && data.userId.size() <= 128
        && data.chatId is string && data.chatId == chatId && data.chatId.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('message' in data) || (data.message is string && data.message.size() <= 200))
        && data.status in ['pending', 'approved', 'declined']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidMessage(data, chatId, msgId) {
      return data.keys().hasAll(['id', 'chatId', 'senderId', 'senderName', 'text', 'type', 'readBy', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'chatId', 'senderId', 'senderName', 'senderPhoto', 'text',
          'type', 'mediaUrl', 'audioDuration', 'callId', 'callerId', 'callType',
          'callStatus', 'callDuration', 'readBy', 'seenByDetails',
          'replyToId', 'replyToText', 'replyToSender', 'replyToType',
          'reactions', 'isEdited', 'editedAt', 'createdAt'
        ])
        && data.id is string && data.id == msgId && data.id.size() <= 128
        && data.chatId is string && data.chatId == chatId && data.chatId.size() <= 128
        && data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.text is string && data.text.size() <= 5000
        && data.type in ['text', 'image', 'audio', 'file', 'call']
        && data.readBy is list && data.readBy.size() >= 1 && data.readBy.size() <= 100 && data.readBy[0] is string
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 1000))
        && (!('mediaUrl' in data) || (
          data.mediaUrl is string &&
          data.mediaUrl.size() <= 950000 &&
          (data.mediaUrl == '' || data.mediaUrl.matches('^data:(image/(jpeg|jpg|png|webp|gif)|audio/[a-zA-Z0-9.+_-]+)(;[a-zA-Z0-9=+._ -]+)*;base64,[A-Za-z0-9+/=]+$'))
        ))
        && (!('audioDuration' in data) || data.audioDuration is number)
        && (!('callId' in data) || (data.callId is string && data.callId.size() <= 128))
        && (!('callerId' in data) || (data.callerId is string && data.callerId.size() <= 128))
        && (!('callType' in data) || data.callType in ['audio', 'video'])
        && (!('callStatus' in data) || data.callStatus in ['completed', 'missed', 'declined', 'cancelled'])
        && (!('callDuration' in data) || (data.callDuration is number && data.callDuration >= 0 && data.callDuration <= 86400))
        && (!('seenByDetails' in data) || data.seenByDetails is map)
        && (!('replyToId' in data) || (data.replyToId is string && data.replyToId.size() <= 128))
        && (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 300))
        && (!('replyToSender' in data) || (data.replyToSender is string && data.replyToSender.size() <= 100))
        && (!('replyToType' in data) || data.replyToType in ['text', 'image', 'audio', 'file', 'call'])
        && (!('reactions' in data) || data.reactions is map)
        && (!('isEdited' in data) || data.isEdited is bool)
        && (!('editedAt' in data) || (data.editedAt is string && data.editedAt.size() <= 64));
    }

    function isValidCallSignal(data, chatId, callId) {
      return data.keys().hasAll(['id', 'chatId', 'callerId', 'calleeId', 'type', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'chatId', 'callerId', 'callerName', 'callerPhoto',
          'calleeId', 'calleeName', 'calleePhoto', 'type', 'status',
          'offer', 'answer', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == callId && data.id.size() <= 128
        && data.chatId is string && data.chatId == chatId && data.chatId.size() <= 128
        && data.callerId is string && data.callerId.size() >= 1 && data.callerId.size() <= 128
        && data.calleeId is string && data.calleeId.size() >= 1 && data.calleeId.size() <= 128
        && data.type in ['audio', 'video']
        && data.status in ['ringing', 'answered', 'declined', 'ended', 'missed']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('callerName' in data) || (data.callerName is string && data.callerName.size() <= 100))
        && (!('callerPhoto' in data) || (data.callerPhoto is string && data.callerPhoto.size() <= 1000))
        && (!('calleeName' in data) || (data.calleeName is string && data.calleeName.size() <= 100))
        && (!('calleePhoto' in data) || (data.calleePhoto is string && data.calleePhoto.size() <= 1000))
        && (!('offer' in data) || (data.offer is map && data.offer.keys().hasOnly(['type', 'sdp']) && data.offer.sdp is string && data.offer.sdp.size() <= 20000))
        && (!('answer' in data) || (data.answer is map && data.answer.keys().hasOnly(['type', 'sdp']) && data.answer.sdp is string && data.answer.sdp.size() <= 20000));
    }

    function isValidIceCandidate(data) {
      return data.keys().hasAll(['candidate'])
        && data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
        && data.candidate is string && data.candidate.size() >= 1 && data.candidate.size() <= 2000
        && (!('sdpMid' in data) || data.sdpMid == null || (data.sdpMid is string && data.sdpMid.size() <= 64))
        && (!('sdpMLineIndex' in data) || data.sdpMLineIndex == null || data.sdpMLineIndex is number)
        && (!('usernameFragment' in data) || data.usernameFragment == null || (data.usernameFragment is string && data.usernameFragment.size() <= 128));
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll(['id', 'reporterId', 'targetUserId', 'reason', 'details', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'reporterId', 'reporterName', 'reporterEmail',
          'reporterPhoneNumber', 'reporterInitialPhoneNumber',
          'targetUserId', 'targetUserName', 'targetUserEmail',
          'targetPhoneNumber', 'targetInitialPhoneNumber',
          'targetAccountCreatedAt', 'targetPhoneChangeCount',
          'chatId', 'messageId',
          'messageText', 'reportedMessageType', 'targetMessageDeleted',
          'reason', 'details', 'status', 'resolvedAt',
          'resolvedBy', 'resolutionNotes', 'createdAt'
        ])
        && data.id is string && data.id == reportId && data.id.size() <= 128
        && data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128
        && data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128
        && data.reason in ['harassment', 'hate_speech', 'spam', 'scam', 'inappropriate', 'impersonation', 'other']
        && data.details is string && data.details.size() <= 2000
        && data.status in ['pending', 'resolved', 'dismissed']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 100))
        && (!('reporterEmail' in data) || (data.reporterEmail is string && data.reporterEmail.size() <= 150))
        && (!('reporterPhoneNumber' in data) || (data.reporterPhoneNumber is string && data.reporterPhoneNumber.size() <= 50))
        && (!('reporterInitialPhoneNumber' in data) || (data.reporterInitialPhoneNumber is string && data.reporterInitialPhoneNumber.size() <= 50))
        && (!('targetUserName' in data) || (data.targetUserName is string && data.targetUserName.size() <= 100))
        && (!('targetUserEmail' in data) || (data.targetUserEmail is string && data.targetUserEmail.size() <= 150))
        && (!('targetPhoneNumber' in data) || (data.targetPhoneNumber is string && data.targetPhoneNumber.size() <= 50))
        && (!('targetInitialPhoneNumber' in data) || (data.targetInitialPhoneNumber is string && data.targetInitialPhoneNumber.size() <= 50))
        && (!('targetAccountCreatedAt' in data) || (data.targetAccountCreatedAt is string && data.targetAccountCreatedAt.size() <= 64))
        && (!('targetPhoneChangeCount' in data) || (data.targetPhoneChangeCount is number && data.targetPhoneChangeCount >= 0 && data.targetPhoneChangeCount <= 100))
        && (!('chatId' in data) || (data.chatId is string && data.chatId.size() <= 128))
        && (!('messageId' in data) || (data.messageId is string && data.messageId.size() <= 128))
        && (!('messageText' in data) || (data.messageText is string && data.messageText.size() <= 1000))
        && (!('reportedMessageType' in data) || data.reportedMessageType in ['text', 'image', 'audio', 'file'])
        && (!('targetMessageDeleted' in data) || data.targetMessageDeleted is bool)
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && (!('resolvedBy' in data) || (data.resolvedBy is string && data.resolvedBy.size() <= 150))
        && (!('resolutionNotes' in data) || (data.resolutionNotes is string && data.resolutionNotes.size() <= 1000));
    }

    function isValidAnnouncement(data, annId) {
      return data.keys().hasAll(['id', 'title', 'content', 'type', 'active', 'createdAt', 'createdBy'])
        && data.keys().hasOnly([
          'id', 'title', 'content', 'type', 'active', 'createdAt',
          'createdBy', 'authorName', 'expiresAt'
        ])
        && data.id is string && data.id == annId && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 3000
        && data.type in ['info', 'warning', 'alert', 'update']
        && data.active is bool
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100))
        && (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64));
    }

    function isValidAdminLog(data, logId) {
      return data.keys().hasAll(['id', 'adminEmail', 'action', 'details', 'timestamp'])
        && data.keys().hasOnly(['id', 'adminEmail', 'action', 'targetId', 'targetName', 'details', 'timestamp'])
        && data.id is string && data.id == logId && data.id.size() <= 128
        && data.adminEmail is string && data.adminEmail.size() >= 1 && data.adminEmail.size() <= 150
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 100
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 1000
        && data.timestamp is string && data.timestamp.size() <= 64
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 150));
    }

    function isValidRecoveryRequest(data, reqId) {
      return data.keys().hasAll(['id', 'email', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'email', 'name', 'username', 'contactPhone', 'topic', 'requesterUid', 'details',
          'status', 'adminNotes', 'resetEmailSentAt', 'resetEmailSentTo', 'resolvedAt', 'resolvedBy', 'createdAt'
        ])
        && data.id is string && data.id == reqId && data.id.size() <= 128
        && data.email is string && data.email.size() <= 150
        && data.status in ['pending', 'resolved', 'dismissed']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 50))
        && (!('topic' in data) || data.topic in ['app_lock', 'lost_email', 'suspended', 'other'])
        && (!('requesterUid' in data) || (data.requesterUid is string && data.requesterUid.size() >= 1 && data.requesterUid.size() <= 128))
        && (!('details' in data) || (data.details is string && data.details.size() <= 1000))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && (!('resetEmailSentAt' in data) || (data.resetEmailSentAt is string && data.resetEmailSentAt.size() <= 64))
        && (!('resetEmailSentTo' in data) || (data.resetEmailSentTo is string && data.resetEmailSentTo.size() <= 150))
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && (!('resolvedBy' in data) || (data.resolvedBy is string && data.resolvedBy.size() <= 150));
    }

    function isValidAppUpdate(data) {
      return data.keys().hasAll(['versionName', 'versionCode', 'apkDownloadUrl', 'changelogEn', 'changelogBn', 'publishedAt', 'publishedBy'])
        && data.keys().hasOnly([
          'versionName', 'versionCode', 'apkDownloadUrl', 'apkSha256',
          'fileSizeBytes', 'fileSizeText', 'changelogEn', 'changelogBn',
          'forceUpdate', 'minSupportedVersion', 'publishedAt', 'publishedBy'
        ])
        && data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 32
        && data.versionCode is number && data.versionCode >= 100
        && data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 500
        && data.apkDownloadUrl.matches('^https://github\\.com/mydatasarverorg-ux/Anomahchat/releases/.*')
        && !data.apkDownloadUrl.matches('.*(@|\\.\\.).*')
        && (!('apkSha256' in data) || (data.apkSha256 is string && data.apkSha256.size() == 64 && data.apkSha256.matches('^[a-fA-F0-9]{64}$')))
        && (!('fileSizeBytes' in data) || data.fileSizeBytes is number)
        && (!('fileSizeText' in data) || (data.fileSizeText is string && data.fileSizeText.size() <= 32))
        && data.changelogEn is string && data.changelogEn.size() <= 4000
        && data.changelogBn is string && data.changelogBn.size() <= 4000
        && (!('forceUpdate' in data) || data.forceUpdate is bool)
        && (!('minSupportedVersion' in data) || data.minSupportedVersion is number)
        && data.publishedAt is string && data.publishedAt.size() <= 64
        && data.publishedBy is string && data.publishedBy.size() <= 150;
    }

    function isValidDeviceSession(data, userId, deviceId) {
      return data.keys().hasAll([
          'deviceId', 'userId', 'platformCategory', 'runtimeType',
          'deviceLabel', 'status', 'createdAt', 'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'deviceId', 'userId', 'platformCategory', 'runtimeType', 'deviceLabel',
          'approxLocation', 'status', 'isPrimaryTrusted', 'adminAlertPending', 'limitBlocked',
          'approvedByDeviceId', 'rejectedByDeviceId', 'rejectionNote',
          'createdAt', 'lastActiveAt', 'loginAt'
        ])
        && data.deviceId is string && data.deviceId == deviceId && data.deviceId.size() <= 128
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.platformCategory in ['mobile', 'web']
        && data.runtimeType in ['apk', 'pwa', 'web']
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 150
        && data.status in ['active', 'pending_approval', 'rejected', 'logged_out']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.lastActiveAt is string && data.lastActiveAt.size() <= 64
        && (!('approxLocation' in data) || data.approxLocation == null || (data.approxLocation is string && data.approxLocation.size() <= 120))
        && (!('isPrimaryTrusted' in data) || data.isPrimaryTrusted is bool)
        && (!('adminAlertPending' in data) || data.adminAlertPending is bool)
        && (!('limitBlocked' in data) || data.limitBlocked is bool)
        && (!('approvedByDeviceId' in data) || data.approvedByDeviceId == null || (data.approvedByDeviceId is string && data.approvedByDeviceId.size() <= 128))
        && (!('rejectedByDeviceId' in data) || data.rejectedByDeviceId == null || (data.rejectedByDeviceId is string && data.rejectedByDeviceId.size() <= 128))
        && (!('rejectionNote' in data) || data.rejectionNote == null || (data.rejectionNote is string && data.rejectionNote.size() <= 300))
        && (!('loginAt' in data) || (data.loginAt is string && data.loginAt.size() <= 64));
    }

    function isValidSecuritySettings(data) {
      return data.keys().hasAll([
          'defaultMobileLimit', 'defaultWebLimit', 'requireApprovalForNewDevice', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'defaultMobileLimit', 'defaultWebLimit', 'requireApprovalForNewDevice', 'updatedAt', 'updatedBy'
        ])
        && data.defaultMobileLimit is number && data.defaultMobileLimit >= 0 && data.defaultMobileLimit <= 20
        && data.defaultWebLimit is number && data.defaultWebLimit >= 0 && data.defaultWebLimit <= 20
        && data.requireApprovalForNewDevice is bool
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy is string && data.updatedBy.size() <= 150;
    }

    function isValidAdminSecuritySettings(data) {
      return data.keys().hasAll([
          'adminMobileLimit', 'adminWebLimit', 'adminLoginMode', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'adminMobileLimit', 'adminWebLimit', 'adminLoginMode', 'updatedAt', 'updatedBy'
        ])
        && data.adminMobileLimit is number && data.adminMobileLimit >= 0 && data.adminMobileLimit <= 20
        && data.adminWebLimit is number && data.adminWebLimit >= 0 && data.adminWebLimit <= 20
        && data.adminLoginMode in ['fast_alert', 'strict_approval']
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy is string && data.updatedBy.size() <= 150;
    }

    // 1. Private User Accounts (PII, moderation state, activity stats)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId) && isCallerNotBanned() && isValidUserCreate(incoming(), userId);

      allow update: if isSignedIn() && isValidId(userId) && isValidUserUpdate(incoming(), existing()) && (
        isAdmin() ||
        (isOwner(userId) && (
          // Action 1: Presence and active minutes tracking
          incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'lastSeen', 'lastLoginAt', 'lastExitAt', 'dailyActivity', 'totalActiveMinutes']) ||
          // Action 2: Profile, phone (immutable initial + append-only history + server-time 30d cooldown) & sign-in sync
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'about', 'photoURL', 'username', 'email',
              'phoneNumber', 'initialPhoneNumber', 'initialPhoneSetAt',
              'phoneHistory', 'lastPhoneChangedAt', 'lastPhoneChangedAtMs', 'phoneChangeCooldownBypass',
              'discoverableByPhone', 'themePreference', 'isOnline', 'lastSeen'
            ]) &&
            (!('email' in incoming().diff(existing()).affectedKeys()) ||
              (request.auth.token.email is string && incoming().email.lower() == request.auth.token.email.lower())) &&
            (!('initialPhoneNumber' in existing()) || existing().initialPhoneNumber == null ||
              (('initialPhoneNumber' in incoming()) && incoming().initialPhoneNumber == existing().initialPhoneNumber)) &&
            (!('initialPhoneSetAt' in existing()) || existing().initialPhoneSetAt == null ||
              (('initialPhoneSetAt' in incoming()) && incoming().initialPhoneSetAt == existing().initialPhoneSetAt)) &&
            (!('phoneHistory' in existing()) ||
              (('phoneHistory' in incoming()) && incoming().phoneHistory.size() >= existing().phoneHistory.size())) &&
            (!('phoneChangeCooldownBypass' in incoming()) || incoming().phoneChangeCooldownBypass == false) &&
            (
              !('initialPhoneNumber' in existing()) || existing().initialPhoneNumber == null ||
              !('phoneNumber' in incoming().diff(existing()).affectedKeys()) ||
              incoming().phoneNumber == existing().phoneNumber ||
              (
                isCallerNotBanned() &&
                ('lastPhoneChangedAtMs' in incoming()) &&
                incoming().lastPhoneChangedAtMs is number &&
                incoming().lastPhoneChangedAtMs >= request.time.toMillis() - 300000 &&
                incoming().lastPhoneChangedAtMs <= request.time.toMillis() + 300000 &&
                (
                  (('phoneChangeCooldownBypass' in existing()) && existing().phoneChangeCooldownBypass == true && incoming().phoneChangeCooldownBypass == false) ||
                  (!('lastPhoneChangedAtMs' in existing()) || existing().lastPhoneChangedAtMs == null ||
                    request.time.toMillis() >= existing().lastPhoneChangedAtMs + 2592000000)
                )
              )
            )
          ) ||
          // Action 3: Toggle Quick App-Lock PIN flag
          incoming().diff(existing()).affectedKeys().hasOnly(['hasAppLockPin']) ||
          // Action 4: Acknowledge official warning
          (incoming().diff(existing()).affectedKeys().hasOnly(['warningDismissed']) && incoming().warningDismissed == true) ||
          // Action 5: Schedule 15-day deletion or restore account
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deleteRequestedAt', 'deleteScheduledAt', 'isOnline', 'lastSeen']) && incoming().status in ['active', 'scheduled_for_deletion', 'deleted']) ||
          // Action 6: Claim expired temporary suspension verified against Firestore server time
          (
            ('isBanned' in existing()) && existing().isBanned == true &&
            ('bannedUntilMs' in existing()) && existing().bannedUntilMs is number &&
            request.time.toMillis() >= existing().bannedUntilMs &&
            incoming().isBanned == false && incoming().bannedUntilMs == null &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isBanned', 'banReason', 'bannedAt', 'bannedBy', 'bannedUntil', 'bannedUntilMs'])
          )
        ))
      );

      // Owner cannot self-delete their account record (prevents ban/phone-history bypass)
      allow delete: if isValidId(userId) && isAdmin();

      // Owner-private hashed Quick App-Lock PIN
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(docId) && docId == 'security'
          && isOwner(userId) && isValidSecurityLock(incoming());
        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }

      // Per-Device Sessions (Device Limits + Login Quarantine Approval)
      match /sessions/{deviceId} {
        allow get: if isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isValidId(userId) && isValidId(deviceId)
          && isValidDeviceSession(incoming(), userId, deviceId)
          && (isOwner(userId) || isAdmin());
        allow update: if isSignedIn() && isValidId(userId) && isValidId(deviceId)
          && isValidDeviceSession(incoming(), userId, deviceId)
          && incoming().deviceId == existing().deviceId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && (isOwner(userId) || isAdmin());
        allow delete: if isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
      }
    }

    // 1A. Immutable Ban Tombstones (Admin-managed; cannot be erased by user self-deletion)
    match /bans/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(userId) && isValidBanRecord(incoming(), userId);
      allow delete: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) &&
          ('bannedUntilMs' in existing()) && existing().bannedUntilMs is number &&
          request.time.toMillis() >= existing().bannedUntilMs)
      );
    }

    // 2. Non-PII Discovery & Presence Directory (Strictly excludes email and credentials)
    match /directory/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (isAdmin() || existing().status in ['active', 'scheduled_for_deletion']);

      allow create: if isSignedIn() && isValidId(userId) && isValidDirectoryUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().userId == userId &&
          (!('isBanned' in incoming()) || incoming().isBanned == true || isCallerNotBanned()))
      );

      allow update: if isSignedIn() && isValidId(userId) && isValidDirectoryUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'userId', 'displayName', 'photoURL', 'about', 'username', 'phoneLookupHash',
            'status', 'isOnline', 'lastSeen', 'isBanned'
          ]) &&
          (!('isBanned' in incoming()) || incoming().isBanned == true || isCallerNotBanned()))
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 2A. Privacy-Preserving Phone Quota & Ban-Lock Registry (Max 3 accounts per number)
    match /phone_registry/{phoneHash} {
      allow get: if isValidId(phoneHash) && (isAdmin() || (isSignedIn() && isValidPhoneHash(phoneHash)));
      allow list: if isAdmin();

      allow create: if isValidId(phoneHash) && isValidPhoneRegistry(incoming(), phoneHash) && (
        isAdmin() ||
        (isSignedIn()
          && isCallerNotBanned()
          && incoming().maxLimit == 3
          && incoming().isBlocked == false
          && (!('manualBlock' in incoming()) || incoming().manualBlock == false)
          && (!('bannedUids' in incoming()) || incoming().bannedUids.size() == 0)
          && (!('manuallyReleasedUids' in incoming()) || incoming().manuallyReleasedUids.size() == 0)
          && (!('blockedReason' in incoming()) || incoming().blockedReason == null)
          && incoming().accountUids.size() == 1
          && incoming().accountUids[0] == request.auth.uid)
      );

      allow update: if isSignedIn() && isValidId(phoneHash) && isValidPhoneRegistry(incoming(), phoneHash) && (
        isAdmin() ||
        (incoming().phoneHash == existing().phoneHash
          && incoming().createdAt == existing().createdAt
          && incoming().maxLimit == existing().maxLimit && (
          // Action 1: Claim 1 slot for self (only if not blocked and within maxLimit)
          (isCallerNotBanned()
            && existing().isBlocked != true
            && (!('manualBlock' in existing()) || existing().manualBlock != true)
            && incoming().isBlocked == existing().isBlocked
            && !(request.auth.uid in existing().accountUids)
            && request.auth.uid in incoming().accountUids
            && incoming().accountUids.size() == existing().accountUids.size() + 1
            && incoming().accountUids.size() <= existing().maxLimit
            && incoming().accountUids.hasAll(existing().accountUids)
            && (
              ((!('manuallyReleasedUids' in existing()) || !(request.auth.uid in existing().manuallyReleasedUids))
                && incoming().diff(existing()).affectedKeys().hasOnly(['accountUids', 'updatedAt'])) ||
              (('manuallyReleasedUids' in existing())
                && (request.auth.uid in existing().manuallyReleasedUids)
                && ('manuallyReleasedUids' in incoming())
                && !(request.auth.uid in incoming().manuallyReleasedUids)
                && incoming().manuallyReleasedUids.size() + 1 == existing().manuallyReleasedUids.size()
                && existing().manuallyReleasedUids.hasAll(incoming().manuallyReleasedUids)
                && incoming().diff(existing()).affectedKeys().hasOnly(['accountUids', 'manuallyReleasedUids', 'updatedAt']))
            )) ||
          // Action 2: Release ONLY self slot when switching phone or after expired deletion (blocked/banned users cannot self-release)
          (isCallerNotBanned()
            && (!('bannedUids' in existing()) || !(request.auth.uid in existing().bannedUids))
            && incoming().isBlocked == existing().isBlocked
            && (request.auth.uid in existing().accountUids)
            && !(request.auth.uid in incoming().accountUids)
            && incoming().accountUids.size() + 1 == existing().accountUids.size()
            && existing().accountUids.hasAll(incoming().accountUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['accountUids', 'updatedAt'])) ||
          // Action 3: Self-clear expired temporary suspension from bannedUids once master profile is unbanned
          (isCallerNotBanned()
            && ('bannedUids' in existing())
            && (request.auth.uid in existing().bannedUids)
            && !(request.auth.uid in incoming().bannedUids)
            && incoming().bannedUids.size() + 1 == existing().bannedUids.size()
            && existing().bannedUids.hasAll(incoming().bannedUids)
            && incoming().isBlocked == (incoming().bannedUids.size() > 0 || (('manualBlock' in existing()) && existing().manualBlock == true))
            && ((incoming().isBlocked == true && incoming().blockedReason == existing().blockedReason)
                || (incoming().isBlocked == false && (!('blockedReason' in incoming()) || incoming().blockedReason == null)))
            && incoming().diff(existing()).affectedKeys().hasOnly(['bannedUids', 'isBlocked', 'blockedReason', 'updatedAt']))
        ))
      );

      allow delete: if isValidId(phoneHash) && isAdmin();
    }

    // 2B. Friendships & Requests (Gated 1-on-1 connections)
    match /friendships/{friendshipId} {
      allow get: if isValidId(friendshipId) && (
        isAdmin() ||
        (isSignedIn() && (
          (resource == null && friendshipId.matches('^pair_.*') && request.auth.uid in friendshipId.split('_')) ||
          (resource != null && request.auth.uid in existing().userIds)
        ))
      );

      allow list: if isAdmin() || (isSignedIn() && request.auth.uid in existing().userIds);

      allow create: if isSignedIn() && isValidId(friendshipId) && isValidFriendship(incoming(), friendshipId) && (
        isAdmin() ||
        (isCallerNotBanned() &&
          incoming().requesterId == request.auth.uid &&
          incoming().status == 'pending' &&
          (!('blockedBy' in incoming()) || incoming().blockedBy == null))
      );

      allow update: if isSignedIn() && isValidId(friendshipId) && isValidFriendship(incoming(), friendshipId) && (
        isAdmin() ||
        (request.auth.uid in existing().userIds &&
          incoming().id == existing().id &&
          incoming().userIds == existing().userIds &&
          incoming().createdAt == existing().createdAt && (
          // Action 1: Receiver accepts or declines pending request
          (isCallerNotBanned() && existing().status == 'pending' &&
            request.auth.uid == existing().receiverId &&
            incoming().requesterId == existing().requesterId &&
            incoming().receiverId == existing().receiverId &&
            incoming().status in ['accepted', 'declined'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'receiverProfile', 'requesterProfile'])) ||
          // Action 2: Resend request after previous decline/unfriend (never when blocked)
          (isCallerNotBanned() && existing().status == 'declined' &&
            incoming().requesterId == request.auth.uid &&
            incoming().status == 'pending' &&
            (!('blockedBy' in incoming()) || incoming().blockedBy == null) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['requesterId', 'receiverId', 'status', 'source', 'requesterProfile', 'receiverProfile', 'updatedAt'])) ||
          // Action 3: Unfriend an accepted friendship (transitions cleanly to declined so DMs lock)
          (existing().status == 'accepted' &&
            incoming().status == 'declined' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          // Action 4: Block user
          (existing().status != 'blocked' &&
            incoming().status == 'blocked' &&
            incoming().blockedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'blockedBy', 'updatedAt'])) ||
          // Action 5: Blocker unblocks user (reverts to declined, never auto-accepts)
          (existing().status == 'blocked' &&
            existing().blockedBy == request.auth.uid &&
            incoming().status == 'declined' &&
            (!('blockedBy' in incoming()) || incoming().blockedBy == null) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'blockedBy', 'updatedAt']))
        ))
      );

      // Blocked users CANNOT delete a block record to bypass blocking
      allow delete: if isValidId(friendshipId) && (
        isAdmin() ||
        (isSignedIn() && request.auth.uid in existing().userIds && (
          (existing().status == 'pending' && request.auth.uid == existing().requesterId) ||
          existing().status == 'declined' ||
          (existing().status == 'blocked' && existing().blockedBy == request.auth.uid)
        ))
      );
    }

    // 2C. Public Groups Discovery Index (Zero messages, zero member PII)
    match /public_groups/{groupId} {
      allow get: if isValidId(groupId) && isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && existing().status == 'active');

      allow create: if isSignedIn() && isValidId(groupId) && isValidPublicGroup(incoming(), groupId) && (
        isAdmin() ||
        (isCallerNotBanned() &&
          incoming().creatorId == request.auth.uid &&
          request.auth.uid in incoming().adminIds &&
          incoming().status == 'active')
      );

      allow update: if isSignedIn() && isValidId(groupId) && isValidPublicGroup(incoming(), groupId) && (
        isAdmin() ||
        (isCallerNotBanned() &&
          incoming().groupId == existing().groupId &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt && (
          // Action 1: Group admin updates public metadata or member count
          (request.auth.uid in existing().adminIds || request.auth.uid == existing().creatorId) ||
          // Action 2: Direct-join user increments memberCount atomically by +1 during self-join
          (existing().status == 'active' &&
            existing().joinPolicy == 'direct' &&
            incoming().memberCount == existing().memberCount + 1 &&
            exists(/databases/$(database)/documents/chats/$(groupId)) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(groupId)).data.participantIds &&
            (!('bannedUserIds' in get(/databases/$(database)/documents/chats/$(groupId)).data) ||
              !(request.auth.uid in get(/databases/$(database)/documents/chats/$(groupId)).data.bannedUserIds)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'updatedAt']))
        ))
      );

      allow delete: if isValidId(groupId) && (
        isAdmin() ||
        (isSignedIn() && (request.auth.uid in existing().adminIds || request.auth.uid == existing().creatorId))
      );
    }

    // 3. Direct & Group Chat Rooms
    match /chats/{chatId} {
      allow get: if isValidId(chatId) && (
        isAdmin() ||
        (isSignedIn() && (
          (resource == null && chatId.matches('^dm_.*') && request.auth.uid in chatId.split('_')) ||
          (resource != null && request.auth.uid in existing().participantIds)
        ))
      );

      allow list: if isAdmin() || (isSignedIn() && request.auth.uid in existing().participantIds);

      allow create: if isValidId(chatId) && isValidChat(incoming()) && (
        isAdmin() ||
        (isSignedIn() && isCallerNotBanned()
          && request.auth.uid in incoming().participantIds
          && (!('isSuspended' in incoming()) || incoming().isSuspended == false)
          && (
            (incoming().type == 'direct' && hasAcceptedFriendshipForDm(incoming().participantIds)) ||
            (incoming().type == 'group' && ('creatorId' in incoming()) && incoming().creatorId == request.auth.uid && ('adminIds' in incoming()) && request.auth.uid in incoming().adminIds)
          ))
      );

      allow update: if isSignedIn() && isValidId(chatId) && isValidChat(incoming()) && (
        isAdmin() ||
        // Non-member self-joining an active Public Direct-Join Group (strictly appends ONLY self)
        (isCallerNotBanned() &&
          existing().type == 'group' &&
          ('visibility' in existing()) && existing().visibility == 'public' &&
          ('joinPolicy' in existing()) && existing().joinPolicy == 'direct' &&
          !(request.auth.uid in existing().participantIds) &&
          (!('bannedUserIds' in existing()) || !(request.auth.uid in existing().bannedUserIds)) &&
          incoming().type == existing().type &&
          incoming().createdAt == existing().createdAt &&
          request.auth.uid in incoming().participantIds &&
          incoming().participantIds.size() == existing().participantIds.size() + 1 &&
          incoming().participantIds.hasAll(existing().participantIds) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantDetails', 'updatedAt'])) ||
        (request.auth.uid in existing().participantIds &&
          incoming().type == existing().type &&
          incoming().createdAt == existing().createdAt && (
          // Action 1: Last message snippet sync on send (prevents sender spoofing)
          (isCallerNotBanned() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageId', 'lastMessageText', 'lastMessageSenderId',
              'lastMessageTime', 'lastMessageReadBy', 'updatedAt'
            ]) &&
            (!('lastMessageSenderId' in incoming().diff(existing()).affectedKeys()) ||
              incoming().lastMessageSenderId == request.auth.uid ||
              incoming().lastMessageSenderId in ['', 'system'] ||
              (incoming().lastMessageId is string &&
                incoming().lastMessageId.size() >= 1 &&
                exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(incoming().lastMessageId)) &&
                get(/databases/$(database)/documents/chats/$(chatId)/messages/$(incoming().lastMessageId)).data.senderId == incoming().lastMessageSenderId))) ||
          // Action 2: Group admin manages title, settings, members, bans, and admins
          (isCallerNotBanned() && existing().type == 'group' &&
            (!('adminIds' in existing()) || request.auth.uid in existing().adminIds || (('creatorId' in existing()) && existing().creatorId == request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'description', 'visibility', 'joinPolicy', 'bannedUserIds',
              'participantIds', 'participantDetails', 'adminIds',
              'lastMessageId', 'lastMessageText', 'lastMessageSenderId',
              'lastMessageTime', 'lastMessageReadBy', 'updatedAt'
            ])) ||
          // Action 3: Group member leaves the group themselves
          (isCallerNotBanned() && existing().type == 'group' &&
            !(request.auth.uid in incoming().participantIds) &&
            (!('adminIds' in incoming()) || !(request.auth.uid in incoming().adminIds)) &&
            incoming().participantIds.size() + 1 == existing().participantIds.size() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'participantIds', 'adminIds', 'lastMessageId', 'lastMessageText',
              'lastMessageSenderId', 'lastMessageTime', 'lastMessageReadBy', 'updatedAt'
            ])) ||
          // Action 4: Direct chat leave when removing self
          (existing().type == 'direct' &&
            incoming().participantIds.size() + 1 == existing().participantIds.size() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'updatedAt']) &&
            !(request.auth.uid in incoming().participantIds)) ||
          // Action 5: Claim expired suspension sync after master profile reinstated
          (isCallerNotBanned() &&
            (!('isSuspended' in incoming()) || incoming().isSuspended == false) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['participantDetails', 'isSuspended', 'suspendedUserId', 'suspendedUserName'])) ||
          // Action 6: Sync read receipt for last message preview in inbox
          (incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageReadBy']) &&
            incoming().lastMessageReadBy is list &&
            request.auth.uid in incoming().lastMessageReadBy)
        ))
      );

      allow delete: if isValidId(chatId) && (
        isAdmin() ||
        (isSignedIn() && request.auth.uid in existing().participantIds && (
          existing().type == 'direct' ||
          existing().participantIds.size() <= 1 ||
          (('adminIds' in existing()) && request.auth.uid in existing().adminIds) ||
          (('creatorId' in existing()) && existing().creatorId == request.auth.uid)
        ))
      );

      // Public Group Join Requests Sub-Collection
      match /join_requests/{reqUserId} {
        allow get: if isValidId(chatId) && isValidId(reqUserId) && (
          isAdmin() ||
          isOwner(reqUserId) ||
          (isSignedIn() && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
            request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId
          ))
        );

        allow list: if isValidId(chatId) && (
          isAdmin() ||
          (isSignedIn() && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
            request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId
          ))
        );

        allow create: if isSignedIn() && isValidId(chatId) && isValidId(reqUserId)
          && isOwner(reqUserId)
          && isCallerNotBanned()
          && isValidJoinRequest(incoming(), chatId, reqUserId)
          && incoming().status == 'pending'
          && exists(/databases/$(database)/documents/public_groups/$(chatId))
          && get(/databases/$(database)/documents/public_groups/$(chatId)).data.status == 'active'
          && get(/databases/$(database)/documents/public_groups/$(chatId)).data.joinPolicy == 'approval'
          && !(request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
          && (!('bannedUserIds' in get(/databases/$(database)/documents/chats/$(chatId)).data)
              || !(request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.bannedUserIds));

        allow update: if isSignedIn() && isValidId(chatId) && isValidId(reqUserId)
          && isValidJoinRequest(incoming(), chatId, reqUserId)
          && incoming().userId == existing().userId
          && incoming().chatId == existing().chatId
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (isCallerNotBanned() &&
              (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
               request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId) &&
              incoming().status in ['approved', 'declined']) ||
            (isOwner(reqUserId) && isCallerNotBanned() && existing().status == 'declined' &&
              incoming().status == 'pending' &&
              (!('bannedUserIds' in get(/databases/$(database)/documents/chats/$(chatId)).data)
                || !(request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.bannedUserIds)))
          );

        allow delete: if isValidId(chatId) && isValidId(reqUserId) && (
          isAdmin() ||
          isOwner(reqUserId) ||
          (isSignedIn() && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
            request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId
          ))
        );
      }

      // Messages Sub-Collection (Master Gate to parent chat participantIds + DM Friendship Gate)
      match /messages/{messageId} {
        allow get: if isValidId(chatId) && isValidId(messageId) && (
          isAdmin() ||
          (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
        );

        allow list: if isValidId(chatId) && (
          isAdmin() ||
          (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
        );

        allow create: if isValidId(chatId) && isValidId(messageId)
          && isValidMessage(incoming(), chatId, messageId)
          && (
            isAdmin() ||
            (isSignedIn()
              && incoming().senderId == request.auth.uid
              && isCallerNotBanned()
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
              && canDirectParticipantsInteract(get(/databases/$(database)/documents/chats/$(chatId)).data)
              && (!('isSuspended' in get(/databases/$(database)/documents/chats/$(chatId)).data) ||
                  get(/databases/$(database)/documents/chats/$(chatId)).data.isSuspended != true))
          );

        allow update: if isValidId(chatId) && isValidId(messageId)
          && isValidMessage(incoming(), chatId, messageId)
          && incoming().senderId == existing().senderId
          && incoming().chatId == existing().chatId
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (isSignedIn()
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
              && (
                incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'seenByDetails']) ||
                (isCallerNotBanned() && incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])) ||
                (isCallerNotBanned() && existing().senderId == request.auth.uid &&
                  incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt']) &&
                  incoming().isEdited == true)
              ))
          );

        allow delete: if isValidId(chatId) && isValidId(messageId) && (
          isAdmin() ||
          (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && (
            existing().senderId == request.auth.uid ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'direct' ||
            (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' && (
              get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.size() <= 1 ||
              (('adminIds' in get(/databases/$(database)/documents/chats/$(chatId)).data) &&
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds) ||
              (('creatorId' in get(/databases/$(database)/documents/chats/$(chatId)).data) &&
                get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId == request.auth.uid)
            ))
          ))
        );
      }

      // 1-on-1 WebRTC Call Signaling Sub-Collection
      match /calls/{callId} {
        allow get, list: if isValidId(chatId) && (
          isAdmin() ||
          (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
        );

        allow create: if isSignedIn() && isValidId(chatId) && isValidId(callId)
          && isValidCallSignal(incoming(), chatId, callId)
          && incoming().callerId == request.auth.uid
          && incoming().status == 'ringing'
          && isCallerNotBanned()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'direct'
          && canDirectParticipantsInteract(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && incoming().calleeId in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && incoming().calleeId != request.auth.uid;

        allow update: if isSignedIn() && isValidId(chatId) && isValidId(callId)
          && isValidCallSignal(incoming(), chatId, callId)
          && incoming().callerId == existing().callerId
          && incoming().calleeId == existing().calleeId
          && incoming().chatId == existing().chatId
          && incoming().createdAt == existing().createdAt
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && (request.auth.uid == existing().callerId || request.auth.uid == existing().calleeId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answer', 'updatedAt']);

        allow delete: if isValidId(chatId) && isValidId(callId) && (
          isAdmin() ||
          (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
        );

        match /offerCandidates/{candidateId} {
          allow get, list: if isValidId(chatId) && isValidId(callId) && (
            isAdmin() ||
            (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
          );
          allow create: if isSignedIn() && isValidId(chatId) && isValidId(callId) && isValidId(candidateId)
            && isValidIceCandidate(incoming())
            && get(/databases/$(database)/documents/chats/$(chatId)/calls/$(callId)).data.callerId == request.auth.uid;
          allow delete: if isValidId(chatId) && isValidId(callId) && isValidId(candidateId) && (
            isAdmin() ||
            (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
          );
        }

        match /answerCandidates/{candidateId} {
          allow get, list: if isValidId(chatId) && isValidId(callId) && (
            isAdmin() ||
            (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
          );
          allow create: if isSignedIn() && isValidId(chatId) && isValidId(callId) && isValidId(candidateId)
            && isValidIceCandidate(incoming())
            && get(/databases/$(database)/documents/chats/$(chatId)/calls/$(callId)).data.calleeId == request.auth.uid;
          allow delete: if isValidId(chatId) && isValidId(callId) && isValidId(candidateId) && (
            isAdmin() ||
            (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
          );
        }
      }
    }

    // 4. Abuse & Violation Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(reportId) && isValidReport(incoming(), reportId)
        && incoming().reporterId == request.auth.uid
        && incoming().targetUserId != request.auth.uid
        && incoming().status == 'pending'
        && !('targetMessageDeleted' in incoming())
        && !('resolvedAt' in incoming())
        && !('resolvedBy' in incoming())
        && !('resolutionNotes' in incoming());
      allow update: if isAdmin() && isValidId(reportId) && isValidReport(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().reporterId == existing().reporterId
        && incoming().targetUserId == existing().targetUserId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // 5. Global Announcements
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (isAdmin() || (isSignedIn() && existing().active == true));
      allow list: if isAdmin() || (isSignedIn() && existing().active == true);
      allow create: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming(), announcementId);
      allow update: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming(), announcementId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // 6. Immutable Super Admin Audit Logs
    match /admin_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAdminLog(incoming(), logId);
      allow update, delete: if false;
    }

    // 7. Account Recovery Support Tickets (Submittable pre-login; Admin-only read/resolve)
    match /recovery_requests/{requestId} {
      allow get: if isValidId(requestId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(requestId) && isValidRecoveryRequest(incoming(), requestId)
        && incoming().status == 'pending'
        && (!('requesterUid' in incoming()) || (isSignedIn() && incoming().requesterUid == request.auth.uid))
        && (incoming().email.size() >= 3
            || ('contactPhone' in incoming() && incoming().contactPhone.size() >= 5)
            || ('username' in incoming() && incoming().username.size() >= 3))
        && !('adminNotes' in incoming())
        && !('resetEmailSentAt' in incoming())
        && !('resetEmailSentTo' in incoming())
        && !('resolvedAt' in incoming())
        && !('resolvedBy' in incoming());
      allow update: if isAdmin() && isValidId(requestId) && isValidRecoveryRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // 8. In-App APK Auto-Updater Releases (GitHub Releases URL allowlisted, Super Admin write only)
    match /app_updates/{updateId} {
      allow get: if isValidId(updateId) && (updateId == 'latest' || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(updateId) && updateId == 'latest' && isValidAppUpdate(incoming());
      allow delete: if isAdmin() && isValidId(updateId);
    }

    // 8A. Global Security & Device Quota Settings (Signed-in read for 'security'; Super Admin only for 'admin_security')
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && (isAdmin() || (isSignedIn() && settingId == 'security'));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && (
        (settingId == 'security' && isValidSecuritySettings(incoming())) ||
        (settingId == 'admin_security' && isValidAdminSecuritySettings(incoming()))
      );
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // 9. Connection verification probe
    match /test/{docId} {
      allow get: if isValidId(docId);
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'chinisdramaorg@gmail.com';
    }

    // Users directory
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'isBanned']) || request.resource.data.role == 'user');
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'isBanned',
          'banReason',
          'bannedAt',
          'bannedBy',
          'warningNotice',
          'warningIssuedAt'
        ])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pinFailedAttempts',
          'pinLockedUntil',
          'isOnline',
          'lastSeen'
        ])
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Chats collection
    match /chats/{chatId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      // Messages sub-collection
      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
        allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Abuse & Violation Reports (Normal users can submit; Only Super Admin can read/manage)
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow get, list, update, delete: if isAdmin();
    }

    // Global Announcements (Everyone can view; Only Super Admin can write/edit/delete)
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Super Admin Audit Log (Strictly Super Admin only)
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Password Recovery Desk Requests (Anyone can submit recovery; Admin reviews & resolves)
    match /recovery_requests/{requestId} {
      allow create: if request.resource.data.email is string;
      allow get: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow list, update, delete: if isAdmin();
    }

    // Public test document for connection verification
    match /test/{docId} {
      allow read: if true;
    }
  }
}
